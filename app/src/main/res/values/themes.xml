<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Common base (shared by light & dark) -->
    <style name="Base.Theme.Netcut" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>

        <item name="materialButtonStyle">@style/Widget.Netcut.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Netcut.Button.Outlined</item>
        <item name="materialButtonTonalStyle">@style/Widget.Netcut.Button.Tonal</item>
    </style>

    <!-- LIGHT: dark icons on light status bar -->
    <style name="Theme.Netcut" parent="Base.Theme.Netcut">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Themed dialogs (adapts automatically to light/dark) -->
    <style name="Theme.Netcut.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="android:background">@color/surface</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Netcut.Dialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Netcut.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Netcut.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Netcut.Dialog.Button</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="shapeAppearanceOverlay">@style/Netcut.Dialog.Shape</item>
    </style>

    <style name="Netcut.Dialog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Netcut.Dialog.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Netcut.Dialog.Shape" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>

    <style name="Widget.Netcut.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Netcut.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Netcut.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>