<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cb_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Unnamed"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface" />

        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Online"
            android:textSize="13sp"
            android:textColor="@color/success"/>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_ip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="IP: 192.168.1.1"
        android:textSize="13sp"
        android:layout_marginTop="4dp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tv_mac"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MAC: AA:BB:CC:DD:EE:FF"
        android:textSize="13sp"
        android:textColor="@color/on_surface_variant" />

    <TextView
        android:id="@+id/tv_last_seen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last seen: Never"
        android:textSize="12sp"
        android:textColor="@color/gray_400" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btn_ping"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="Ping"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/gray_500"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_details"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="Details"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_ban"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="Ban"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:backgroundTint="@color/error"
            android:layout_marginStart="4dp" />
    </LinearLayout>

</LinearLayout>