<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="16dp"
    android:paddingEnd="24dp"
    android:paddingBottom="28dp"
    android:background="@color/surface">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/border"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp" />

    <!-- Device Name -->
    <TextView
        android:id="@+id/tv_sheet_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Device Name"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-black"
        android:ellipsize="end"
        android:maxLines="1"
        android:layout_marginBottom="20dp" />

    <!-- Network Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/surface_variant"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK INFORMATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/text_tertiary"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP Address"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="14dp" />

            <TextView
                android:id="@+id/tv_sheet_ip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="192.168.1.1"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAC Address"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary" />

            <TextView
                android:id="@+id/tv_sheet_mac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AA:BB:CC:DD:EE:FF"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Status Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_sheet_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        app:cardBackgroundColor="@color/success_container"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/success">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:padding="16dp">

            <View
                android:id="@+id/dot_sheet_status"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/success" />

            <TextView
                android:id="@+id/tv_sheet_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Online"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/success"
                android:layout_marginStart="12dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- First / Last Seen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FIRST SEEN"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_tertiary"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tv_sheet_first_seen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Never"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LAST SEEN"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_tertiary"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tv_sheet_last_seen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Never"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Action: Ban -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sheet_ban"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Ban Device"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/on_error"
        app:backgroundTint="@color/error"
        app:cornerRadius="16dp"
        android:layout_marginBottom="8dp" />

    <!-- Action: Protect -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sheet_protect"
        style="@style/Widget.Material3.Button"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Protect Device"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/on_primary"
        app:backgroundTint="@color/primary"
        app:cornerRadius="16dp"
        android:layout_marginBottom="14dp" />

    <!-- Action: Ping + Rename -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_ping"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Ping"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/primary"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp"
            android:layout_marginEnd="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sheet_rename"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="Rename"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            app:backgroundTint="@color/surface_variant"
            app:cornerRadius="14dp"
            android:layout_marginStart="5dp" />
    </LinearLayout>

    <!-- Action: Close -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sheet_close"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Close"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textColor="@color/text_secondary" />
</LinearLayout>