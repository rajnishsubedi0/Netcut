<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ============ TOP ACTION BAR (logo · title · play/pause · loader · ⋮) ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/devices"
            android:padding="5dp"
            android:contentDescription="NetCut"
            app:tint="@color/primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NetCut"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="8dp" />

        <!-- ROUND PLAY / PAUSE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="Start service"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_play"
            app:iconSize="20dp"
            app:iconTint="@color/btn_start_text"
            app:backgroundTint="@color/btn_start_bg"
            app:cornerRadius="21dp" />

        <!-- CIRCULAR LOADING SPINNER -->
        <ProgressBar
            android:id="@+id/progress_loading"
            style="@style/Widget.AppCompat.ProgressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="9dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            android:layout_marginStart="2dp" />

        <!-- THREE-DOT OVERFLOW MENU -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:contentDescription="More options"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_more_vert"
            app:iconSize="20dp"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>

    <!-- ============ THIN SCAN PROGRESS LINE (like WiFiKill blue line) ============ -->
    <ProgressBar
        android:id="@+id/scan_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- ============ SERVICE STATUS STRIP ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bg_running_notrunning_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/status_stopped_bg"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <View
                android:id="@+id/green_red"
                android:layout_width="9dp"
                android:layout_height="9dp"
                android:background="@color/status_stopped" />

            <TextView
                android:id="@+id/service_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Service is not running"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="7dp" />

            <TextView
                android:id="@+id/device_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banned: 0 • Protected: 0"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============ SEARCH + TABS ============ -->
    <!-- ============ SEARCH + TABS ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Search devices"
                android:textColorHint="@color/text_tertiary"
                app:hintTextColor="@color/primary"
                app:boxBackgroundColor="@color/surface_variant"
                app:boxStrokeColor="@color/primary"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_tertiary"
                app:endIconMode="clear_text"
                app:endIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/ll_selection_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ban_selected"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Ban (0)"
                    android:textSize="12sp"
                    android:textColor="@color/error"
                    app:backgroundTint="@color/error_container"
                    app:cornerRadius="10dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_unban_selected"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="Unban (0)"
                    android:textSize="12sp"
                    android:textColor="@color/success"
                    app:backgroundTint="@color/success_container"
                    app:cornerRadius="10dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_selection"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="0.8"
                    android:text="Clear"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="10dp"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </FrameLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            android:padding="3dp"
            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_connected"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Connected"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/tab_selected_text"
                app:backgroundTint="@color/tab_selected_bg"
                app:strokeColor="@android:color/transparent"
                app:cornerRadius="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_banned"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Banned"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/tab_unselected_text"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                app:cornerRadius="9dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_tab_protected"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Protected"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/tab_unselected_text"
                app:backgroundTint="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                app:cornerRadius="9dp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>


    <!-- ============ DEVICE LIST ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_connected"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background"
                android:nestedScrollingEnabled="true"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_banned"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:nestedScrollingEnabled="true"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_protected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:nestedScrollingEnabled="true"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />
    </FrameLayout>
    <!-- ============ BOTTOM ACTION BAR (counts · restore all · ban all) ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 devices online"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restore_all"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Restore All"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            app:backgroundTint="@color/success_container"
            app:cornerRadius="10dp"
            android:layout_marginEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ban_all"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="Ban All"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/error"
            app:backgroundTint="@color/error_container"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>