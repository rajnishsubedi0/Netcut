<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

    <!-- ============ TOP ACTION BAR (blends like Settings header) ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/background"
        android:elevation="4dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="NetCut"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logs"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Session logs"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_logs"
            app:iconSize="22dp"
            app:iconTint="@color/text_secondary"
            android:layout_marginEnd="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Start service"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_play"
            app:iconSize="22dp"
            app:iconTint="@color/btn_start_text"
            app:backgroundTint="@color/btn_start_bg"
            app:cornerRadius="22dp" />

        <ProgressBar
            android:id="@+id/progress_loading"
            style="@style/Widget.AppCompat.ProgressBar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/primary"
            android:visibility="gone"
            android:layout_marginStart="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="More options"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@drawable/ic_more_vert"
            app:iconSize="22dp"
            app:iconTint="@color/text_secondary" />
    </LinearLayout>

    <!-- ============ THIN SCAN PROGRESS LINE ============ -->
    <ProgressBar
        android:id="@+id/scan_progress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/primary"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <!-- ============ SERVICE STATUS STRIP ============ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bg_running_notrunning_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/status_stopped_bg"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <View
                android:id="@+id/green_red"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@color/status_stopped" />

            <TextView
                android:id="@+id/service_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Service is not running"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/device_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Banned: 0 • Protected: 0"
                android:textSize="13sp"
                android:textColor="@color/text_tertiary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ============ SEARCH + TABS ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <!-- Fixed height FrameLayout to prevent jitter -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_container"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="Search devices"
                android:textColorHint="@color/text_tertiary"
                app:hintTextColor="@color/primary"
                app:boxBackgroundColor="@color/surface_variant"
                app:boxStrokeColor="@color/primary"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="2dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:startIconDrawable="@drawable/ic_search"
                app:startIconTint="@color/text_tertiary"
                app:endIconMode="clear_text"
                app:endIconTint="@color/text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/ll_selection_actions"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:visibility="gone"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ban_selected"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Ban (0)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/error"
                    app:backgroundTint="@color/error_container"
                    app:cornerRadius="12dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_unban_selected"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Unban (0)"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/success"
                    app:backgroundTint="@color/success_container"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_selection"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="0.8"
                    android:text="Clear"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_secondary"
                    app:cornerRadius="12dp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- ============ MATERIAL 3 TABS (replaces MaterialButtonToggleGroup) ============ -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_variant"
            app:tabMode="fixed"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/primary"
            app:tabIndicatorHeight="3dp"
            app:tabIndicatorFullWidth="true"
            app:tabIndicatorAnimationMode="elastic"
            app:tabSelectedTextColor="@color/primary"
            app:tabTextColor="@color/text_secondary"
            app:tabRippleColor="@color/ripple"
            app:tabTextAppearance="@style/TextAppearance.AppCompat.Body1"
            app:tabPaddingStart="2dp"
            app:tabPaddingEnd="2dp" />
    </LinearLayout>

    <!-- ============ DEVICE LIST ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_connected"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/background"
                android:nestedScrollingEnabled="true"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                android:scrollbars="vertical" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_banned"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:nestedScrollingEnabled="true"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_protected"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:nestedScrollingEnabled="true"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_saved"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background"
            android:nestedScrollingEnabled="true"
            android:visibility="gone"
            android:clipToPadding="false"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />
    </FrameLayout>

    <!-- ============ BOTTOM ACTION BAR ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/surface"
        android:elevation="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tv_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0 devices online"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_restore_all"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Restore All"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/success"
            app:backgroundTint="@color/success_container"
            app:cornerRadius="12dp"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_ban_all"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="Ban All"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/error"
            app:backgroundTint="@color/error_container"
            app:cornerRadius="12dp" />
    </LinearLayout>
</LinearLayout>