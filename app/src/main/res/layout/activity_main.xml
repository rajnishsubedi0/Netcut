<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp"
        tools:context=".MainActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="NetCut"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#212121" />

            <ImageView
                android:id="@+id/btn_settings"
                android:background="@drawable/settings"
                android:layout_width="40dp"
                android:layout_height="40dp"/>

        </LinearLayout>

        <LinearLayout
           android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_card"

            android:layout_marginTop="10dp">
            <ImageView
                android:background="@drawable/devices"
                android:layout_width="70dp"
                android:layout_height="70dp"/>
        <LinearLayout

            android:layout_gravity="center"

            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:textColor="@color/gray"
                android:id="@+id/tv_stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 devices online"
                android:textSize="20dp"/>

            <TextView
                android:textColor="@color/gray"
                android:id="@+id/device_stats"
                android:textSize="14dp"
                android:text=" 0 banned • 0 protected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        </LinearLayout>
    <LinearLayout
        android:id="@+id/bg_running_notrunning_layout"
        android:padding="10dp"
        android:background="@drawable/bg_card_for_servicenotrunning_layout"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:gravity="center"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:layout_weight="15"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
    <ImageView
        android:id="@+id/green_red"
        android:src="@drawable/green_dot"
        android:scaleType="fitXY"
        android:layout_width="20dp"
        android:layout_height="20dp"/>

        <TextView
            android:id="@+id/service_status"
            android:layout_weight="1"
            android:text="Service is not running"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        </LinearLayout>

        <Button
            app:backgroundTint="@null"
            android:background="@drawable/bg_card_for_start_stop_btn_not_running"
            android:id="@+id/btn_start"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Start"

            android:textAllCaps="false"
            android:textColor="@color/gray"
            android:textSize="16sp"
            android:textStyle="bold"

             />

    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_ban_all"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Ban All"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_restore_all"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="Restore All"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_search"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:hint="Search by name, IP or MAC"
            android:textSize="14sp"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/ll_selection_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_ban_selected"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="Ban (0)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#F44336"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_unban_selected"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="Unban (0)"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btn_clear_selection"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:text="Clear"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#607D8B"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_tab_connected"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="Connected"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:backgroundTint="#2196F3"
                        android:textColor="#FFFFFF"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_tab_banned"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="44dp"
                        android:text="Banned"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        android:backgroundTint="#E0E0E0"
                        android:textColor="#424242"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_connected"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_banned"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />
                </FrameLayout>

            </LinearLayout>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>