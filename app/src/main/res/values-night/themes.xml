<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Netcut" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your dark theme here. -->
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorOnPrimary">@color/gray_900</item>
        
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorOnSecondary">@color/gray_900</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/gray_900</item>
        
        <!-- Background colors -->
        <item name="android:colorBackground">@color/gray_900</item>
        <item name="colorSurface">@color/gray_800</item>
        <item name="colorOnSurface">@color/gray_100</item>
        <item name="colorOnSurfaceVariant">@color/gray_400</item>
        
        <!-- Error color -->
        <item name="colorError">@color/error_light</item>
        <item name="colorOnError">@color/gray_900</item>
    </style>
</resources>